<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.epptools</groupId>
  <artifactId>epptools-sdk</artifactId>
  <version>1.1.1</version>
  <packaging>jar</packaging>

  <name>EppTools EPP SDK for Java</name>
  <description>Dependency-free Java client for EPP domain registries (RFC 5730-5734 over TLS), with a
    registry's own extensions discovered from its greeting.</description>
  <url>https://github.com/epptools/java-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>EppTools</name>
      <url>https://github.com/epptools</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/epptools/java-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/epptools/java-sdk.git</developerConnection>
    <url>https://github.com/epptools/java-sdk</url>
    <tag>v1.1.1</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/epptools/java-sdk/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- release, not source/target: it compiles against the Java 8 API as well as the Java 8 language
         level, so a newer JDK cannot slip a method that does not exist on 8 into the jar. -->
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <!-- No <dependencies> element, and that is the point: the library uses javax.net.ssl for the TLS
       transport and javax.xml for DOM, both of which are in the JDK. There are no tests in the tree
       either, so there is no test scope to declare. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- Maven Central requires a sources jar beside the binary one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Central requires a javadoc jar too. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <source>8</source>
          <encoding>UTF-8</encoding>
          <docencoding>UTF-8</docencoding>
          <charset>UTF-8</charset>
          <!-- Every doclint check except the one that asks for a comment on each accessor: the
               short getters on Response are named after the EPP element they read and a paragraph
               each would say less than the name does. -->
          <doclint>all,-missing</doclint>
          <!-- Do not fetch the JDK's own package list over the network to cross-link it; a build
               that needs the internet to produce a javadoc jar fails on a machine without one. -->
          <detectJavaApiLink>false</detectJavaApiLink>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- The module name for anyone building on the module path. Without it the name is
                   derived from the jar's filename, which is not something this project promises:
                   renaming the artefact would then break every `requires` that names it. Declared
                   here rather than in a module-info.java, which a Java 8 target cannot carry. -->
              <Automatic-Module-Name>com.epptools.sdk</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Central requires a detached PGP signature for every artifact. Signing lives in a profile so
         an ordinary `mvn install` needs no key and no passphrase; publish with
         `mvn deploy -Prelease`, which signs the jar, the sources jar and the javadoc jar. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- gpg asks for the passphrase on its own tty, which a CI job does not have.
                       Loopback mode makes it read the one Maven passes instead of hanging. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
