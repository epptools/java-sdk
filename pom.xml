<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.epptools</groupId>
  <artifactId>epptools-sdk</artifactId>
  <version>1.1.2</version>
  <packaging>jar</packaging>

  <name>EppTools EPP SDK for Java</name>
  <description>Dependency-free Java client for EPP domain registries (RFC 5730-5734 over TLS), with a
    registry's own extensions discovered from its greeting.</description>
  <url>https://github.com/epptools/java-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>EppTools</name>
      <url>https://github.com/epptools</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/epptools/java-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/epptools/java-sdk.git</developerConnection>
    <url>https://github.com/epptools/java-sdk</url>
    <tag>v1.1.2</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/epptools/java-sdk/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- release, not source/target: it compiles against the Java 8 API as well as the Java 8 language
         level, so a newer JDK cannot slip a method that does not exist on 8 into the jar. -->
    <maven.compiler.release>8</maven.compiler.release>
    <!-- Declared so that -DskipTests turns off the offline suite below as well as Surefire. Without it
         the two would disagree about what skipping tests means. -->
    <skipTests>false</skipTests>
  </properties>

  <!-- No <dependencies> element, and that is the point: the library uses javax.net.ssl for the TLS
       transport and javax.xml for DOM, both of which are in the JDK. The suite in src/test/java has no
       dependencies either - it is a plain main() with its own assertions and no test framework - so
       there is still no test scope to declare. What it does need is something to RUN it, which is the
       exec-maven-plugin execution further down: before that, `mvn verify` compiled every assertion in
       it and executed none, and only tools/run-matrix.sh ever ran the suite at all. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- Surefire has nothing to find here and says so on every build; silenced so that its
           "No tests to run" does not sit beside the suite's own tally and read as a contradiction.
           The suite is not a Surefire suite: it has no framework, on purpose. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <!-- Run the offline suite in the test phase, so `mvn test`, `mvn verify` and `mvn install` all
           execute it and a failing assertion fails the build.
           The `exec` goal, not `java`: it FORKS a JVM. The suite ends with System.exit, which under the
           in-process goal would take Maven down with it and report whatever exit code it felt like. A
           forked JVM turns that exit code into a build failure, which is what it is for.
           workingDirectory is the project root because the suite reads README.md and docs/ to check that
           every version and install coordinate the documentation states agrees with Version.VERSION. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>offline-suite</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${java.home}/bin/java</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-cp</argument>
                <classpath/>
                <argument>com.epptools.sdk.OfflineTest</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Maven Central requires a sources jar beside the binary one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Central requires a javadoc jar too. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <source>8</source>
          <encoding>UTF-8</encoding>
          <docencoding>UTF-8</docencoding>
          <charset>UTF-8</charset>
          <!-- Every doclint check except the one that asks for a comment on each accessor: the
               short getters on Response are named after the EPP element they read and a paragraph
               each would say less than the name does. -->
          <doclint>all,-missing</doclint>
          <!-- Do not fetch the JDK's own package list over the network to cross-link it; a build
               that needs the internet to produce a javadoc jar fails on a machine without one. -->
          <detectJavaApiLink>false</detectJavaApiLink>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- The module name for anyone building on the module path. Without it the name is
                   derived from the jar's filename, which is not something this project promises:
                   renaming the artefact would then break every `requires` that names it. Declared
                   here rather than in a module-info.java, which a Java 8 target cannot carry. -->
              <Automatic-Module-Name>com.epptools.sdk</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Central requires a detached PGP signature for every artifact. Signing lives in a profile so
         an ordinary `mvn install` needs no key and no passphrase; publish with
         `mvn deploy -Prelease`, which signs the jar, the sources jar and the javadoc jar. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- gpg asks for the passphrase on its own tty, which a CI job does not have.
                       Loopback mode makes it read the one Maven passes instead of hanging. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
